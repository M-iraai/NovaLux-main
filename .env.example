# Copy to .env and fill in real values. Never commit .env.

# ─── Supabase (client, exposed in the bundle — use the anon key only) ───
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ─── Cloudflare R2 (server-only; used by /api/upload, /api/image, /api/delete) ───
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-access-key-id
R2_SECRET_ACCESS_KEY=your-secret-access-key
R2_BUCKET=your-bucket
R2_PUBLIC_URL=https://your-bucket.your-subdomain.r2.dev

# ─── ECOTRACK (server-only; powers /api/orders, /api/wilayas, /api/communes,
#     /api/fees, /api/desks) ───
ECOTRACK_TOKEN=your-ecotrack-api-token
ECOTRACK_BASE_URL=https://your-ecotrack-host
